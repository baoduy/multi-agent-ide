{
  "name": "multi-agent-ide",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm build && pnpm -C packages/main dev",
    "dev:watch": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "install-all": "bash install-all.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "chokidar": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "electron": "41.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "reactflow": "^11.10.0",
    "simple-git": "^3.35.2",
    "ulid": "^3.0.2",
    "zustand": "^5.0.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.2",
    "typescript": "6.0.2"
  }
}