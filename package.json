{
  "name": "multi-agent-ide",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-repo multi-agent IDE for spec-driven development",
  "author": "Steven Hoang <drunkcoding@outlook.com>",
  "main": "packages/main/dist/index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm build && pnpm -C packages/main dev",
    "dev:watch": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "update": "npx npm-check-updates -u && pnpm install",
    "pack": "pnpm build && pnpm exec electron-builder --dir",
    "dist": "pnpm build && pnpm exec electron-builder",
    "dist:mac": "pnpm build && pnpm exec electron-builder --mac",
    "dist:win": "pnpm build && pnpm exec electron-builder --win",
    "dist:linux": "pnpm build && pnpm exec electron-builder --linux",
    "release": "pnpm build && pnpm exec electron-builder --publish always",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "sql.js": "^1.14.1",
    "chokidar": "5.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reactflow": "^11.11.4",
    "simple-git": "^3.36.0",
    "ulid": "^3.0.2",
    "lucide-react": "1.8.0",
    "zustand": "^5.0.12",
    "zod": "4.3.6",
    "marked": "18.0.0",
    "marked-highlight": "^2.2.4",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@electron/rebuild": "*",
    "@types/sql.js": "^1.4.11",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "41.2.0",
    "esbuild": "^0.28.0",
    "electron-builder": "26.8.1",
    "typescript": "6.0.2"
  }
}