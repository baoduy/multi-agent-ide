import path from "node:path";

import type { SpecFolder } from "@magenta/shared/models";
import type { DatabaseService } from "../db/DatabaseService";
import type { IPCBridge } from "../ipc/IPCBridge";
import type { BackgroundJobManager } from "./BackgroundJobManager";
import { SpecReader } from "./SpecReader";

const TAG = "[SpecCache]";

/** Extract the repo folder name from a full path for readable logs. */
function repoName(repoPath: string): string {
  return path.basename(repoPath);
}

/**
 * Cache TTL in milliseconds (15 minutes).
 */
const CACHE_TTL_MS = 15 * 60 * 1000;

interface CacheRow {
  repo_path: string;
  specs_json: string;
  cached_at: number;
}

/**
 * Result from getSpecs — tells the caller whether data came from cache
 * so the frontend can decide whether to show a loading indicator.
 */
export interface SpecCacheResult {
  specs: SpecFolder[];
  /** true = data came from a fresh cache, false = data was fetched live */
  fromCache: boolean;
}

/**
 * SpecCacheService provides a DB-backed cache for spec listings.
 *
 * Flow on `spec:list`:
 *   1. Cache is fresh (< 15 min) → return cached data instantly (fromCache=true).
 *      A background refresh is enqueued via BackgroundJobManager; when done,
 *      if data changed, it emits `spec:list:updated` so the UI refreshes.
 *      The caller is NEVER blocked by the background refresh.
 *
 *   2. Cache is expired / missing BUT a background job is already running
 *      for this repo → await that job and return the fresh result.
 *
 *   3. Cache is expired / missing, no job running → start a refresh,
 *      await it, cache the result, and return (fromCache=false).
 *
 * Multiple repos can refresh concurrently. Each repo has at most one
 * in-flight refresh at a time — deduplication is handled by
 * BackgroundJobManager.
 */
export class SpecCacheService {
  private readonly db: DatabaseService;
  private readonly specReader: SpecReader;
  private readonly bridge: IPCBridge;
  private readonly jobManager: BackgroundJobManager;

  /**
   * In-flight refresh promises keyed by repoPath.
   * Used only for cache-MISS blocking refreshes — background (fire-and-forget)
   * refreshes go through the BackgroundJobManager and don't need a promise.
   */
  private readonly inflightRefresh = new Map<string, Promise<SpecFolder[]>>();

  constructor(db: DatabaseService, bridge: IPCBridge, jobManager: BackgroundJobManager) {
    this.db = db;
    this.specReader = new SpecReader();
    this.bridge = bridge;
    this.jobManager = jobManager;
  }

  /* ═══════════════════════════════════════════════════════
     Public API
     ═══════════════════════════════════════════════════════ */

  /**
   * Returns specs for a repo, using the cache when possible.
   *
   * See class-level doc for full flow description.
   */
  async getSpecs(repoPath: string): Promise<SpecCacheResult> {
    const name = repoName(repoPath);
    const cached = this.readCache(repoPath);

    if (cached) {
      const ageSeconds = ((Date.now() - cached.cachedAt) / 1000).toFixed(1);
      console.log(`${TAG} [${name}] DB cache HIT — ${cached.specs.length} specs, age ${ageSeconds}s. Returning from cache.`);
      // Enqueue a background refresh via job manager — fire-and-forget.
      // If one is already queued/running for this repo, this is a no-op.
      this.enqueueBackgroundRefresh(repoPath);
      return { specs: cached.specs, fromCache: true };
    }

    // ── Cache MISS or expired ───────────────────────────
    const inflight = this.inflightRefresh.get(repoPath);
    if (inflight) {
      console.log(`${TAG} [${name}] DB cache MISS — refresh already in-flight, waiting…`);
      const specs = await inflight;
      return { specs, fromCache: false };
    }

    console.log(`${TAG} [${name}] DB cache MISS — starting blocking refresh…`);
    const t0 = Date.now();
    const specs = await this.doBlockingRefresh(repoPath);
    console.log(`${TAG} [${name}] Blocking refresh done — ${specs.length} specs in ${Date.now() - t0}ms`);
    return { specs, fromCache: false };
  }

  /**
   * Invalidate the cache for a specific repo (e.g. after branch checkout).
   */
  invalidate(repoPath: string): void {
    const sqlite = this.db.getSqlite();
    sqlite.prepare(`DELETE FROM spec_cache WHERE repo_path = ?`).run(repoPath);
  }

  /**
   * Invalidate all cached specs.
   */
  invalidateAll(): void {
    const sqlite = this.db.getSqlite();
    sqlite.exec(`DELETE FROM spec_cache`);
  }

  /**
   * Returns true if a background refresh is currently running for this repo.
   */
  isRefreshing(repoPath: string): boolean {
    const jobName = this.jobNameFor(repoPath);
    return this.jobManager.has(jobName) || this.inflightRefresh.has(repoPath);
  }

  /* ═══════════════════════════════════════════════════════
     Cache read / write
     ═══════════════════════════════════════════════════════ */

  private readCache(repoPath: string): { specs: SpecFolder[]; cachedAt: number } | null {
    const sqlite = this.db.getSqlite();
    const row = sqlite
      .prepare(`SELECT specs_json, cached_at FROM spec_cache WHERE repo_path = ?`)
      .get(repoPath) as CacheRow | undefined;

    if (!row) return null;

    const age = Date.now() - row.cached_at;
    if (age > CACHE_TTL_MS) {
      // Expired — remove stale entry
      sqlite.prepare(`DELETE FROM spec_cache WHERE repo_path = ?`).run(repoPath);
      return null;
    }

    try {
      const specs = JSON.parse(row.specs_json) as SpecFolder[];
      return { specs, cachedAt: row.cached_at };
    } catch {
      // Corrupt cache — remove it
      sqlite.prepare(`DELETE FROM spec_cache WHERE repo_path = ?`).run(repoPath);
      return null;
    }
  }

  private writeCache(repoPath: string, specs: SpecFolder[]): void {
    const sqlite = this.db.getSqlite();
    const now = Date.now();
    const json = JSON.stringify(specs);

    sqlite
      .prepare(
        `INSERT OR REPLACE INTO spec_cache (repo_path, specs_json, cached_at)
         VALUES (?, ?, ?)`,
      )
      .run(repoPath, json, now);
  }

  /* ═══════════════════════════════════════════════════════
     Job name helper
     ═══════════════════════════════════════════════════════ */

  private jobNameFor(repoPath: string): string {
    return `spec-refresh:${repoPath}`;
  }

  /* ═══════════════════════════════════════════════════════
     Background refresh (fire-and-forget via job manager)
     ═══════════════════════════════════════════════════════ */

  /**
   * Enqueue a background refresh via BackgroundJobManager.
   * If the same job is already queued or running, this is a no-op.
   */
  private enqueueBackgroundRefresh(repoPath: string): void {
    const jobName = this.jobNameFor(repoPath);
    this.jobManager.enqueue(jobName, async () => {
      await this.executeRefresh(repoPath);
    });
  }

  /* ═══════════════════════════════════════════════════════
     Blocking refresh (for cache-miss path)
     ═══════════════════════════════════════════════════════ */

  /**
   * Runs a blocking refresh — the caller awaits the result.
   * Multiple callers for the same repo share a single promise.
   */
  private doBlockingRefresh(repoPath: string): Promise<SpecFolder[]> {
    const existing = this.inflightRefresh.get(repoPath);
    if (existing) return existing;

    const promise = this.executeRefresh(repoPath);
    this.inflightRefresh.set(repoPath, promise);

    void promise.finally(() => {
      this.inflightRefresh.delete(repoPath);
    });

    return promise;
  }

  private async executeRefresh(repoPath: string): Promise<SpecFolder[]> {
    const name = repoName(repoPath);
    const t0 = Date.now();

    try {
      console.log(`${TAG} [${name}] Fetching specs from git branches…`);
      const freshSpecs = await this.specReader.listAllBranchSpecs(repoPath);
      const elapsed = Date.now() - t0;

      // Compare with existing cache to decide whether to push an update
      const oldJson = this.readCacheRaw(repoPath);
      const freshJson = JSON.stringify(freshSpecs);
      const changed = oldJson !== freshJson;

      // Always write fresh data to cache
      this.writeCache(repoPath, freshSpecs);
      console.log(`${TAG} [${name}] Refresh done — ${freshSpecs.length} specs in ${elapsed}ms, changed=${changed}`);

      // Only emit UI update if data actually changed
      if (changed) {
        console.log(`${TAG} [${name}] Data changed — pushing spec:list:updated to UI`);
        this.bridge.emit({
          type: "spec:list:updated" as const,
          repoPath,
          specs: freshSpecs,
        });
      }

      return freshSpecs;
    } catch (error) {
      console.error(`${TAG} [${name}] Refresh FAILED after ${Date.now() - t0}ms:`, error);
      throw error;
    }
  }

  /**
   * Read raw JSON from cache without TTL check (for diffing purposes).
   */
  private readCacheRaw(repoPath: string): string | null {
    const sqlite = this.db.getSqlite();
    const row = sqlite
      .prepare(`SELECT specs_json FROM spec_cache WHERE repo_path = ?`)
      .get(repoPath) as { specs_json: string } | undefined;

    return row?.specs_json ?? null;
  }
}
