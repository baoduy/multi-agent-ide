{
  "name": "@magenta/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end Playwright tests and Claude debugging helpers for the Magenta IDE Electron app. Not shipped in release builds.",
  "scripts": {
    "test": "playwright test",
    "test:bdd": "playwright test --project=bdd",
    "test:smoke": "playwright test --project=smoke",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug --headed",
    "debug:launch": "tsx scripts/debug-electron.ts",
    "debug:inspect": "tsx scripts/inspect.ts",
    "debug:click": "tsx scripts/click.ts",
    "debug:eval": "tsx scripts/eval.ts",
    "debug:snapshot": "tsx scripts/snapshot.ts",
    "debug:stop": "tsx scripts/stop.ts",
    "typecheck": "tsc --noEmit",
    "build": "echo 'no build — e2e package runs via tsx'",
    "lint": "echo 'No linter configured'",
    "update": "npx npm-check-updates -u && pnpm install"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "electron": "^41.2.1",
    "playwright": "^1.59.1",
    "playwright-bdd": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
