{
  "name": "@magenta/main",
  "version": "0.1.0",
  "main": "dist/preload.js",
  "scripts": {
    "dev": "tsc && electron dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "echo 'No tests configured'",
    "update": "npx npm-check-updates -u && pnpm install"
  },
  "dependencies": {
    "@magenta/shared": "workspace:*",
    "electron": "*"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
