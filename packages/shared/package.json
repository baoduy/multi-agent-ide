    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./aiTerminal": {
      "types": "./dist/aiTerminal.d.ts",
      "default": "./dist/aiTerminal.js"
    },
    "./aiSpawnOptions": {
      "types": "./dist/aiSpawnOptions.d.ts",
