{
  "name": "@magenta/ui",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "dev:css": "tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --watch",
    "build": "node esbuild.mjs && tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "echo 'No tests configured'",
    "postinstall": "electron-builder install-app-deps",
    "update": "npx npm-check-updates -u && pnpm install"
  },
  "dependencies": {
    "@magenta/shared": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "@lobehub/icons": "^5.4.0",
    "@lobehub/ui": "^5.7.0",
    "antd": "^6.3.5",
    "mermaid": "^11.14.0",
    "react-diff-viewer-continued": "^4.2.0",
    "reactflow": "^11.11.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "allotment": "^1.20.5",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "esbuild": "^0.28.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4.2.2",
    "typescript": "*"
  }
}