{
  "name": "@magenta/ui",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "dev:css": "tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --watch",
    "build": "node esbuild.mjs && tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "echo 'No tests configured'"
  },
  "dependencies": {
    "@magenta/shared": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "@lobehub/icons": "^1.44.0",
    "strip-ansi": "^6.0.1",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.4",
    "zustand": "*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "esbuild": "^0.25.0",
    "shadcn": "^2.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "*"
  }
}
