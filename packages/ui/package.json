{
  "name": "@magenta/ui",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node esbuild.mjs --watch",
    "dev:css": "tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --watch",
    "build": "node esbuild.mjs && tailwindcss -i src/renderer/styles/globals.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured'",
    "test": "echo 'No tests configured'",
    "update": "npx npm-check-updates -u && pnpm install"
  },
  "dependencies": {
    "@magenta/shared": "workspace:*",
    "@iconify/react": "^5.2.0",
    "@iconify-json/vscode-icons": "^1.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "antd": "^6.3.5",
    "mermaid": "^11.14.0",
    "@uiw/react-md-editor": "^4.1.0",
    "@uiw/react-markdown-preview": "^5.2.0",
    "react-codemirror-merge": "^4.25.9",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-css": "^6.3.1",
    "@uiw/codemirror-theme-github": "^4.25.9",
    "reactflow": "^11.11.4",
    "strip-ansi": "^7.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "allotment": "^1.20.5",
    "radix-ui": "^1.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "esbuild": "^0.28.0",
    "shadcn": "^4.3.0",
    "tailwindcss": "^4.2.2",
    "typescript": "*"
